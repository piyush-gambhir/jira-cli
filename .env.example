# jira-cli build secrets — template. Copy to `.env` and fill in.
#
#   cp .env.example .env   &&   $EDITOR .env
#
# `.env` is gitignored. These values are only used to BAKE a built-in OAuth app
# into the binary (`make build`, `./install.sh`, `scripts/release.sh`) so end
# users can run `jira auth login --type oauth2` and sign in to THEIR OWN Jira in
# the browser without registering their own app. Leave empty to build without an
# embedded app (users then bring their own API token or OAuth app).
#
# Get these from developer.atlassian.com -> your app -> Settings.
# Keep values unquoted and free of '#' and '$'. For exotic secrets, pass them as
# environment variables to the build instead.

JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
