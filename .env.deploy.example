# Cloudflare Pages deploy credentials for `scripts/deploy-docs.sh`.
# Copy to `.env.deploy.production` (gitignored) and fill in — OR skip this file
# entirely and just run `npx wrangler login` once, then `bash scripts/deploy-docs.sh`.
#
# Create a scoped API token at: https://dash.cloudflare.com/profile/api-tokens
# (template: "Cloudflare Pages — Edit"). Account id is on any zone's overview page.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_PROJECT_NAME=jira-cli
