# Optional Cloudflare credentials for `scripts/deploy-docs.sh`.
# Copy to `.env.deploy.production` (gitignored) and fill in, OR skip this file
# entirely and run `pnpm --dir web exec wrangler login` once.
#
# Create a scoped API token at https://dash.cloudflare.com/profile/api-tokens
# (template: "Edit Cloudflare Workers"). The account is pinned in web/wrangler.jsonc.
CLOUDFLARE_API_TOKEN=
